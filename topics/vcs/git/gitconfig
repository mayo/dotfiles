[core]
	excludesfile = /Users/mayo/.gitignore
	symlinks = true
[user]
	name = Mayo Jordanov
	email = mjordanov@wasabi.com
	signingkey = 8AA2D5453E3BD3C3
[alias]
  ci = commit
  st = status
  co = checkout
  up = pull --rebase
[color]
  ui = auto
[push]
  default = simple
[diff]
  tool = gvimdiff
[merge]
  tool = fugitive
[mergetool]
  keepBackup = true

[difftool "gvimdiff"]
  cmd = gvim -f -d \"$LOCAL\" \"$REMOTE\"
[mergetool "fugitive"]
  cmd = gvim -f -c \"Gdiff\" \"$MERGED\"
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
